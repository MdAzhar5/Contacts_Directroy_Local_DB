# Copy this file to ".env" and fill in your own values.
# .env is listed in .gitignore, so it is never committed or pushed. This example file is
# committed on purpose and must never contain a real token.

# Hugging Face access token, needed only to download Foursquare OS Places.
# Create one with "read" scope at https://huggingface.co/settings/tokens, then accept the
# dataset terms at https://huggingface.co/datasets/foursquare/fsq-os-places
HF_TOKEN=

# Optional: use a different database file than leads_app/leads.duckdb
# LEADS_DB=D:\leads\leads.duckdb
